PORT=3000
LLM_API_BASE_URL=https://api.deepseek.com
LLM_API_KEY=your_deepseek_api_key
LLM_MODEL=deepseek-chat
CORS_ORIGIN=http://localhost:5173

# Auth
AUTH_DEFAULT_ADMIN_USERNAME=admin
AUTH_DEFAULT_ADMIN_PASSWORD=admin123
AUTH_DEFAULT_ADMIN_NAME=系统管理员
AUTH_NOTIFY_EMAIL=3279574698@qq.com
AUTH_CODE_EXPIRE_MINUTES=10
AUTH_CODE_RESEND_SECONDS=60

# SMTP mail for registration notification and verification code
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=3279574698@qq.com
MAIL_PASS=your_qq_smtp_authorization_code
MAIL_FROM=3279574698@qq.com

# TTS
TTS_PROVIDER=tencentcloud
TTS_AUTH_TOKEN=
TTS_MAX_TEXT_LENGTH=100000

# Tencent Cloud TTS
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_TTS_REGION=ap-guangzhou
TENCENTCLOUD_TTS_MODE=auto
TENCENTCLOUD_TTS_LONG_TEXT_THRESHOLD=220
TENCENTCLOUD_TTS_POLL_INTERVAL_MS=1500
TENCENTCLOUD_TTS_POLL_TIMEOUT_MS=180000
TENCENTCLOUD_TTS_VOICE_TYPE=101001
TENCENTCLOUD_TTS_SPEED=0
TENCENTCLOUD_TTS_VOLUME=0
TENCENTCLOUD_TTS_SAMPLE_RATE=16000
TENCENTCLOUD_TTS_CODEC=wav
TENCENTCLOUD_TTS_PRIMARY_LANGUAGE=1
TENCENTCLOUD_TTS_PROJECT_ID=0
TENCENTCLOUD_TTS_MODEL_TYPE=1

# Windows local fallback TTS (optional for local development)
WINDOWS_POWERSHELL_PATH=C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe
WINDOWS_TTS_DEFAULT_VOICE=
WINDOWS_TTS_DEFAULT_RATE=0

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=ai_campus_agent

# RAG retrieval tuning
RAG_WEIGHT_EXACT_TITLE=10
RAG_WEIGHT_EXACT_CONTENT=4
RAG_WEIGHT_TERM_TITLE_LONG=5
RAG_WEIGHT_TERM_TITLE_SHORT=3
RAG_WEIGHT_TERM_CONTENT_LONG=2
RAG_WEIGHT_TERM_CONTENT_SHORT=1
RAG_WEIGHT_KEYWORD_MATCH=4
RAG_WEIGHT_CATEGORY_MATCH=2
RAG_WEIGHT_CATEGORY_SCHOLARSHIP_BOOST=3
RAG_WEIGHT_CATEGORY_TEACHING_BOOST=3
RAG_WEIGHT_CATEGORY_EXAM_BOOST=2
RAG_WEIGHT_ROUTE_BOOST=6
RAG_TIME_DECAY_ENABLED=true
RAG_TIME_DECAY_HALFLIFE_DAYS=90
RAG_TIME_DECAY_MIN_FACTOR=0.5
RAG_ROUTE_MIN_HITS=2
RAG_ROUTE_MIN_SCORE=3
RAG_LOG_ENABLED=true

# Vector retrieval / embedding
# hash: local fallback, no external API required
# openai_compatible: OpenAI-compatible embedding gateway
VECTOR_EMBEDDING_PROVIDER=hash
VECTOR_EMBEDDING_DIM=256
VECTOR_EMBEDDING_API_BASE_URL=
VECTOR_EMBEDDING_API_KEY=
VECTOR_EMBEDDING_MODEL=
VECTOR_EMBEDDING_TIMEOUT_MS=30000
RAG_VECTOR_ENABLED=true
RAG_VECTOR_TOPK=8
RAG_KEYWORD_LIMIT_MULTIPLIER=3
RAG_WEIGHT_VECTOR_SCORE=6

# LightRAG API Server (optional)
LIGHTRAG_API_BASE_URL=http://127.0.0.1:9621
LIGHTRAG_API_KEY=
LIGHTRAG_INSERT_ENDPOINT=/documents/texts
LIGHTRAG_QUERY_ENDPOINT=/query
LIGHTRAG_QUERY_MODE=hybrid
LIGHTRAG_TIMEOUT_MS=120000

# LightRAG local server startup.
# `npm run lightrag:start` reads this same server/.env file.
# By default it reuses LLM_API_* for DeepSeek and VECTOR_EMBEDDING_* for SiliconFlow.
LIGHTRAG_HOST=127.0.0.1
LIGHTRAG_PORT=9621
LIGHTRAG_WORKING_DIR=rag_storage/student-handbook
LIGHTRAG_INPUT_DIR=rag_storage/student-handbook/inputs
LIGHTRAG_LLM_BINDING=openai
LIGHTRAG_LLM_BINDING_HOST=https://api.deepseek.com
LIGHTRAG_LLM_BINDING_API_KEY=your_deepseek_api_key
LIGHTRAG_LLM_MODEL=deepseek-chat
LIGHTRAG_EMBEDDING_BINDING=openai
LIGHTRAG_EMBEDDING_BINDING_HOST=https://api.siliconflow.cn/v1
LIGHTRAG_EMBEDDING_BINDING_API_KEY=your_siliconflow_api_key
LIGHTRAG_EMBEDDING_MODEL=BAAI/bge-m3
LIGHTRAG_EMBEDDING_DIM=1024
LIGHTRAG_LOG_LEVEL=INFO

# 设为 true 将 LightRAG 作为主力 RAG（失败时自动回退关键词 RAG）
LIGHTRAG_PRIMARY=false
