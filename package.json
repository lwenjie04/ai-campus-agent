{
  "name": "ai-campus-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.mjs",
    "mail:test": "node server/scripts/test-auth-mail.mjs",
    "ingest:local": "node server/scripts/batch-ingest-local.mjs",
    "ingest:browser-json": "node server/scripts/import-browser-export-json.mjs",
    "kb:handbook:import": "node server/scripts/import-student-handbook-docx.mjs",
    "kb:repair": "node server/scripts/kb-clean-tag-qc.mjs",
    "kb:repair:dry": "node server/scripts/kb-clean-tag-qc.mjs --dry-run",
    "kb:chunk": "node server/scripts/build-chunked-kb.mjs --official-only",
    "kb:chunk:offline": "node server/scripts/build-chunked-kb.mjs --official-only --include-student-handbook --sources-output server/data/offline-knowledge-base.json",
    "kb:vector": "node server/scripts/build-vector-index.mjs",
    "kb:vector:local": "node server/scripts/build-vector-index.mjs --provider hash --dimension 256",
    "kb:vector:check": "node server/scripts/check-vector-readiness.mjs",
    "kb:vector:check:local": "node server/scripts/check-vector-readiness.mjs --expect-provider hash --expect-model hash-256 --expect-dimension 256",
    "kb:prepare:offline": "run-s kb:handbook:import kb:chunk:offline kb:vector:local kb:vector:check:local",
    "kb:prepare:release": "run-s kb:chunk kb:vector kb:vector:check",
    "rag:test:service": "node server/scripts/evaluate-rag-golden.mjs",
    "ci:browser-journeys": "node server/scripts/ci-browser-journeys.mjs",
    "ci:golden:assert": "node server/scripts/assert-rag-golden.mjs server/evals/ci/latest-rag-golden-ci.json 20",
    "ci:service-journey:assert": "node server/scripts/assert-service-journey.mjs",
    "server:check": "node server/scripts/check-server-syntax.mjs",
    "test:server": "node --test server/tests/*.test.mjs",
    "test:mysql:review": "node --test server/tests/community-review-mysql.integration.mjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "release:check": "node server/scripts/release-check.mjs",
    "release:gate": "node server/scripts/check-release-gate.mjs",
    "service:smoke": "node server/scripts/service-smoke.mjs",
    "service:journey:browser": "node server/scripts/service-journey-browser.mjs",
    "service:journey:run": "node server/scripts/run-service-journey.mjs",
    "service:journey": "run-s build service:journey:run",
    "conversation:journey": "node server/scripts/conversation-journey-browser.mjs",
    "auth-intent:journey": "node server/scripts/auth-intent-journey-browser.mjs",
    "home:journey": "node server/scripts/home-flow-browser.mjs",
    "chat:layout": "node server/scripts/chat-layout-browser.mjs",
    "chat:stream": "node server/scripts/chat-stream-browser.mjs",
    "responsive:matrix": "node server/scripts/responsive-matrix.mjs",
    "regression:journey": "node server/scripts/regression-journey-browser.mjs",
    "community:journey": "node server/scripts/community-journey-browser.mjs",
    "admin:journey": "node server/scripts/admin-journey-browser.mjs",
    "closed-loop:journey": "node server/scripts/closed-loop-journey-browser.mjs",
    "ui:inspect:mobile": "node server/scripts/inspect-responsive-layout.mjs",
    "dev:all": "run-p dev server",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "test": "npm run test:server",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:fix": "run-s lint:oxlint:fix lint:eslint:fix",
    "lint:oxlint": "oxlint .",
    "lint:oxlint:fix": "oxlint . --fix",
    "lint:eslint": "eslint . --no-fix --cache",
    "lint:eslint:fix": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "element-plus": "^2.13.2",
    "mysql2": "^3.20.0",
    "nodemailer": "^8.0.4",
    "pinia": "^3.0.4",
    "tencentcloud-sdk-nodejs-tts": "^4.1.182",
    "vue": "^3.5.28",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.10.13",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.46.0",
    "eslint-plugin-vue": "~10.8.0",
    "jiti": "^2.6.1",
    "jsdom": "^27.0.1",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.47.0",
    "prettier": "3.8.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.2.4"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
