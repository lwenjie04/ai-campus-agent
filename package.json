{
  "name": "ai-campus-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.mjs",
    "mail:test": "node server/scripts/test-auth-mail.mjs",
    "ingest:local": "node server/scripts/batch-ingest-local.mjs",
    "ingest:browser-json": "node server/scripts/import-browser-export-json.mjs",
    "kb:repair": "node server/scripts/kb-clean-tag-qc.mjs",
    "kb:repair:dry": "node server/scripts/kb-clean-tag-qc.mjs --dry-run",
    "kb:chunk": "node server/scripts/build-chunked-kb.mjs",
    "kb:vector:check": "node server/scripts/check-vector-readiness.mjs",
    "kb:vector": "node server/scripts/build-vector-index.mjs",
    "handbook:import": "node server/scripts/import-student-handbook-docx.mjs",
    "rag:test": "node server/scripts/test-rag-retrieval.mjs",
    "lightrag:health": "node server/scripts/check-lightrag.mjs",
    "lightrag:start": "node server/scripts/start-lightrag.mjs",
    "lightrag:import": "node server/scripts/import-kb-to-lightrag.mjs",
    "lightrag:query": "node server/scripts/query-lightrag.mjs",
    "codegraph:init": "codegraph init -i",
    "codegraph:index": "codegraph index",
    "codegraph:sync": "codegraph sync",
    "codegraph:status": "codegraph status",
    "codegraph:query": "codegraph query",
    "dev:all": "run-p dev server",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "element-plus": "^2.13.2",
    "jimp": "^1.6.1",
    "mysql2": "^3.20.0",
    "nodemailer": "^8.0.4",
    "pinia": "^3.0.4",
    "tencentcloud-sdk-nodejs-tts": "^4.1.182",
    "tesseract.js": "^7.0.0",
    "vue": "^3.5.28"
  },
  "devDependencies": {
    "@colbymchenry/codegraph": "^0.9.9",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.10.13",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.46.0",
    "eslint-plugin-vue": "~10.8.0",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.47.0",
    "prettier": "3.8.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.0.6",
    "vue-tsc": "^3.2.4"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
